<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black everywhere: no white flash before the WebView paints. Accent = the MSIGN indigo. -->
    <style name="Theme.MSIGN" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#5b57e8</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#5b57e8</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
